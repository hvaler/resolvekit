# ResolveKit environment template. Copy to .env (git-ignored) and fill in only what you need.
# Never commit real values. Every variable is documented in docs/technical/configuration.md.
#
# The server, MeterMCP and the scripts all load this one repository-root .env (node --env-file-if-exists).
# Lines starting with "#" are optional settings shown with their default or an example: uncomment one only to set it.
# An empty value is NOT the same as unset for most of them (e.g. PORT= listens on a random port and
# RESOLVEKIT_DATA_DIR= writes into the current folder).
# [secret] marks values that must stay private.

# ---------------------------------------------------------------------------------------------------------------
# PayPal: the seller's sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
# Used by apps/server (dispute reads, evidence, webhook verification), apps/metermcp (budgets) and demo:prepare.
# Without credentials every case runs on the in-browser simulator.
# ---------------------------------------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
# [secret]
PAYPAL_CLIENT_ID=
# [secret]
PAYPAL_CLIENT_SECRET=
# Hosted mode refuses PAYPAL_ENV=live unless this is exactly "yes-real-money". Leave it unset.
# RESOLVEKIT_ALLOW_LIVE_PAYPAL=

# ---------------------------------------------------------------------------------------------------------------
# Hosted mode only (apps/server). Leave empty for local development.
# ---------------------------------------------------------------------------------------------------------------
# The platform's identity app, owned by ANOTHER sandbox business account: "Continue with PayPal" asks for a
# no-charge Billing Agreements token of it (a seller cannot approve its own app). Must differ from PAYPAL_CLIENT_ID.
# [secret]
PAYPAL_IDENTITY_CLIENT_ID=
# [secret]
PAYPAL_IDENTITY_CLIENT_SECRET=
# The id of the CUSTOMER.DISPUTE.* webhook registered on the seller's app for
# https://<your host>/api/paypal/webhook/<PAYPAL_WEBHOOK_KEY>, and that key (32-128 random URL-safe characters).
# Without both, the webhook route does not exist.
PAYPAL_WEBHOOK_ID=
# [secret]
PAYPAL_WEBHOOK_KEY=
# The operator's check (32-128 random URL-safe characters): the same value on the hosted resolvekit service and here.
# npm run demo:check sends it to GET /api/ops/status; without it on the server, /api/ops/* does not exist.
# [secret]
RESOLVEKIT_OPS_TOKEN=

# RESOLVEKIT_MODE=hosted
# Public origin (Render sets it). Must be https, except localhost.
# RENDER_EXTERNAL_URL=http://localhost:10000
# RESOLVEKIT_CUSTOM_DOMAINS=https://resolvekit.example.com
# Where PayPal returns the buyer after approving an agent run's budget (/agent?run=<id>). Default: RENDER_EXTERNAL_URL.
# RESOLVEKIT_PUBLIC_URL=https://resolvekit.example.com
# HMAC key of the session cookies, 32+ characters. Unset: a per-launch secret (sign-ins end on restart).
# [secret]
# RESOLVEKIT_SESSION_SECRET=
# Bindings: case id -> { dispute, capture } (npm run demo:prepare prints it). Hosted only; wins over the file.
# Example shape (the case id is the standard demo case's; dispute and capture are fictional): {"PP-R-TVH-10190665":{"dispute":"PP-D-EXAMPLE-0001","capture":"EXAMPLECAPTURE01"}}
# BINDINGS_JSON=
# Daily caps (hosted, per UTC day)
# DAILY_LIVE_ANALYSES=60
# DAILY_RECHECKS=200
# DAILY_EVIDENCE_SENDS=20
# DAILY_UPLOADS=40
# DAILY_AGENT_RUNS=20
# Client address behind proxies (Render blueprint: 2 hops)
# TRUSTED_PROXY_HOPS=1
# TRUSTED_PROXY_PEERS=private

# ---------------------------------------------------------------------------------------------------------------
# apps/server: storage and network (both modes)
# ---------------------------------------------------------------------------------------------------------------
# Paths: use absolute paths (npm workspace scripts run from the app's own folder).
# PORT=8787
# default: apps/server/data/
# RESOLVEKIT_DATA_DIR=/absolute/path/to/data
# default: hosted <data>/bindings.json, local apps/server/bindings.json
# RESOLVEKIT_BINDINGS=/absolute/path/bindings.json
# default: apps/web/dist/
# RESOLVEKIT_WEB_DIST=/absolute/path/to/dist
# Retention on the data dir (swept at start and hourly). The audit log, the send log and MeterMCP's ledger never expire.
# A cached live analysis unused (not written or read) this many days is removed; past the size the least recently used go.
# Whole numbers, at least 1 (anything else gives the default); the most recently used analysis is never removed.
# ANALYSIS_CACHE_MAX_DAYS=30
# ANALYSIS_CACHE_MAX_MB=100
# analyst-usage.jsonl: lines older than this are dropped, then the oldest until it fits the size.
# ANALYST_USAGE_MAX_DAYS=90
# ANALYST_USAGE_MAX_MB=10
# Local mode only
# default: apps/server/.runtime-token
# RESOLVEKIT_TOKEN_FILE=/absolute/path/.runtime-token
# RESOLVEKIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Vite proxy target (apps/web)
# RESOLVEKIT_API=http://127.0.0.1:8787

# ---------------------------------------------------------------------------------------------------------------
# AI models (apps/server: analyst and buying agent; scripts: evals, golden, demo-agent, demo:prepare --agent)
# Without either key the committed golden analyses of the demo cases still work; live analysis and the agent are off.
# Calls with these keys may cost money (Gemini) or use free-tier quota (Groq).
# ---------------------------------------------------------------------------------------------------------------
# [secret]
GEMINI_API_KEY=
# [secret]
GROQ_API_KEY=
# The PRIMARY provider of both the analyst and the agent (gemini or groq); the other one, if its key is set, is the fallback.
ANALYST_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# AGENT_GEMINI_MODEL=gemini-3.8-flash
# AGENT_GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TPM=8000
# LIVE_ANALYSES_PER_HOUR=6
# RECHECKS_PER_HOUR=30
# Agent run limits
# AGENT_MAX_ACTIONS=8
# AGENT_MAX_MS=180000
# AGENT_APPROVAL_TIMEOUT_MS=900000
# AGENT_MAX_MODEL_CALLS=12
# AGENT_MAX_INPUT_TOKENS=8000
# AGENT_MAX_OUTPUT_TOKENS=1024
# AGENT_RUN_TOKEN_BUDGET=60000

# ---------------------------------------------------------------------------------------------------------------
# MeterMCP link, as seen by apps/server
# ---------------------------------------------------------------------------------------------------------------
# Base URL or host:port of MeterMCP (Render passes the private host:port).
# METERMCP_URL=http://127.0.0.1:8790
# Hosted: MeterMCP's admin token (the same value on both services, 32+ characters). Local: read from the token file.
# [secret]
# METERMCP_ADMIN_TOKEN=
# default: apps/metermcp/.runtime-token
# METERMCP_TOKEN_FILE=/absolute/path/.runtime-token

# ---------------------------------------------------------------------------------------------------------------
# apps/metermcp
# ---------------------------------------------------------------------------------------------------------------
# METERMCP_MODE=hosted
# METERMCP_PORT=8790
# Return/cancel URLs of the budget order (hosted: https, default RENDER_EXTERNAL_URL)
# METERMCP_PUBLIC_URL=http://127.0.0.1:8790
# METERMCP_CUSTOM_DOMAINS=
# METERMCP_BUDGET=5.00
# METERMCP_MIN_BUDGET=0.50
# Origins an open_budget return_to may point at (comma list), e.g. ResolveKit's public origin
# METERMCP_RETURN_ORIGINS=http://localhost:5173
# METERMCP_IDLE_MINUTES=15
# default: apps/metermcp/data/
# METERMCP_DATA_DIR=/absolute/path/to/data
# default: <data>/metermcp.sqlite
# METERMCP_DB=/absolute/path/metermcp.sqlite
# METERMCP_ALLOWED_ORIGINS=
# Hosted: the code MCP clients send in x-demo-code to create a budget. Unset: no budget can be created.
# [secret]
# DEMO_CODE=
# DAILY_BUDGETS=20
# Local test switch only (never on a hosted service): the first call of these tools fails, never charged, marked injected.
# Applies only to sessions opened by a payment_required proposal; open_budget sessions (agent runs included) ignore it.
# METERMCP_FAIL_FIRST=deep_report

# ---------------------------------------------------------------------------------------------------------------
# Scripts (demo:prepare --agent, demo-agent against the hosted MeterMCP): the same value as DEMO_CODE above.
# demo-agent reads METERMCP_URL as the MCP endpoint, e.g. https://<metermcp host>/mcp (default http://127.0.0.1:8790/mcp;
# it adds /mcp when missing). It shares this .env with the server: override METERMCP_URL on the command line if they differ.
# ---------------------------------------------------------------------------------------------------------------
# [secret]
# METERMCP_DEMO_CODE=
