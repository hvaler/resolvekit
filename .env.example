# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox).
# Never commit real values: .env is git-ignored.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI analyst (apps/server). Gemini is the primary model, Groq the automatic fallback; without either key the
# committed golden analyses of the demo cases still work. ANALYST_PROVIDER=groq makes Groq the primary.
GEMINI_API_KEY=
GROQ_API_KEY=
ANALYST_PROVIDER=gemini
